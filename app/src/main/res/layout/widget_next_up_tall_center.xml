<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Section (Click to open NextUp app) -->
    <LinearLayout
        android:id="@+id/widget_top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar: Header (App) + Alignment toggle button -->
        <LinearLayout
            android:id="@+id/widget_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clickable App Header (icon + title) -->
            <LinearLayout
                android:id="@+id/widget_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_alarm" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Touch target for Alignment Toggle -->
            <ImageView
                android:id="@+id/widget_btn_align_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="@string/widget_alignment_title"
                android:src="@drawable/ic_format_align_center" />
        </LinearLayout>

        <!-- Main countdown center text -->
        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/no_alarm_set"
            android:textColor="@color/widget_on_surface"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_alarm_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider / Subheader -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_chip_bg"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_section_predicted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="UPCOMING ROUTINE"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="10sp" />

    <!-- Predicted Rows (Dynamically shown up to 8 based on widget height) -->
    <!-- Predicted Row 1 -->
    <LinearLayout
        android:id="@+id/widget_predicted_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Left invisible spacer balancing the EST badge to keep middle text centered -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/widget_predicted_1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_est_badge"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="EST"
            android:textColor="@color/widget_chip_text"
            android:textSize="9sp" />
    </LinearLayout>

