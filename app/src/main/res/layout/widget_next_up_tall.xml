<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Header (App) + Alignment toggle button -->
    <LinearLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Clickable App Header (icon + title) -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_alarm" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Touch target for Alignment Toggle -->
        <ImageView
            android:id="@+id/widget_btn_align_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:contentDescription="@string/widget_alignment_title"
            android:src="@drawable/ic_format_align_left" />
    </LinearLayout>

    <!-- Countdown & Target Time: Left-aligned variant -->
    <LinearLayout
        android:id="@+id/widget_alarm_section_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_countdown_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:fontFamily="sans-serif-black"
            android:gravity="start|center_vertical"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:text="@string/no_alarm_set"
            android:textColor="@color/widget_on_surface"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_alarm_time_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="sans-serif"
            android:gravity="start|center_vertical"
            android:textAlignment="viewStart"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Countdown & Target Time: Center-aligned variant -->
    <LinearLayout
        android:id="@+id/widget_alarm_section_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_countdown_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textAlignment="center"
            android:maxLines="1"
            android:text="@string/no_alarm_set"
            android:textColor="@color/widget_on_surface"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_alarm_time_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:ellipsize="none"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textAlignment="center"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_chip_bg"
        android:contentDescription="@null" />

    <!-- Subheader: Left -->
    <TextView
        android:id="@+id/widget_section_predicted_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:textAlignment="viewStart"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:singleLine="true"
        android:text="PREDICTED ROUTINE"
        android:textColor="@color/widget_primary"
        android:textSize="10sp"
        android:visibility="visible" />

    <!-- Subheader: Center -->
    <TextView
        android:id="@+id/widget_section_predicted_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:singleLine="true"
        android:text="PREDICTED ROUTINE"
        android:textColor="@color/widget_primary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Scrollable collection of upcoming routine alarms (hidden scrollbars) -->
    <ListView
        android:id="@+id/widget_alarms_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fadingEdge="none"
        android:nestedScrollingEnabled="true"
        android:scrollbars="none" />

    <!-- Empty state: Left -->
    <TextView
        android:id="@+id/widget_predicted_empty_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:textAlignment="viewStart"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="No upcoming routine alarms"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Empty state: Center -->
    <TextView
        android:id="@+id/widget_predicted_empty_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="No upcoming routine alarms"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
